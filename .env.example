# Copy to .env.local for local development. Never commit real values.

# --- Supabase (accounts + cloud sync). Leave both blank for guest-only mode.
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — safe for the browser; access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- AI tutor (server-only). Leave blank to disable the tutor and coach.
ANTHROPIC_API_KEY=
# Max AI requests per signed-in user per UTC day (1-1000). Default 40.
AI_DAILY_LIMIT=40

# --- Optional: version label shown in the footer/health check. Vercel sets it from the commit SHA.
NEXT_PUBLIC_APP_VERSION=
